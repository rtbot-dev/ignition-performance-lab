#!/bin/sh
set -eu
VERSION='@VERSION@'
EXPECTED='@SHA256@'
URL="https://github.com/rtbot-dev/ignition-performance-lab/releases/download/$VERSION/ignition-performance-lab.zip"
command -v docker >/dev/null || { echo 'Docker is required. Start Docker Desktop, or Docker Engine with Compose on Linux.'; exit 1; }
docker info >/dev/null 2>&1 || { echo 'Docker is not running or your user cannot access it. Start Docker and try again.'; exit 1; }
docker compose version >/dev/null 2>&1 || { echo 'Docker Compose v2 is required.'; exit 1; }
command -v curl >/dev/null || { echo 'curl is required.'; exit 1; }
command -v unzip >/dev/null || { echo 'unzip is required.'; exit 1; }
BASE="${XDG_DATA_HOME:-$HOME/.local/share}/katenaria/ignition-performance-lab"
DEST="$BASE/$VERSION"
mkdir -p "$BASE"
if [ ! -f "$DEST/.installed-$EXPECTED" ]; then
  [ ! -e "$DEST" ] || { echo "Existing incomplete installation: $DEST. Move it aside before retrying."; exit 1; }
  STAGE=$(mktemp -d "$BASE/.download.XXXXXX")
  trap 'rm -rf "$STAGE"' EXIT HUP INT TERM
  echo "Downloading Ignition Performance Lab $VERSION..."
  curl --fail --location --retry 3 --proto '=https' --tlsv1.2 "$URL" -o "$STAGE/lab.zip"
  if command -v sha256sum >/dev/null; then ACTUAL=$(sha256sum "$STAGE/lab.zip" | cut -d ' ' -f 1)
  else ACTUAL=$(shasum -a 256 "$STAGE/lab.zip" | cut -d ' ' -f 1); fi
  [ "$ACTUAL" = "$EXPECTED" ] || { echo 'Download checksum failed. Nothing will run.'; exit 1; }
  unzip -q "$STAGE/lab.zip" -d "$STAGE"
  mv "$STAGE/ignition-performance-lab" "$DEST"
  touch "$DEST/.installed-$EXPECTED"
fi
echo "Local files and results: $DEST"
# Invoke through sh so execution permissions survive ZIP extraction on all platforms.
sh "$DEST/scripts/start.sh" jython-vibration
